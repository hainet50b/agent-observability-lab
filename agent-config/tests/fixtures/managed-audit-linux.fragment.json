{
  "_comment": {
    "docs": [
      "https://code.claude.com/docs/en/settings#managed-settings"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/etc/claude-code/hooks/agent-config/agent-audit.sh' --stream user_prompt --config '/etc/claude-code/hooks/agent-config/agent-audit.conf'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/etc/claude-code/hooks/agent-config/agent-audit.sh' --stream tool_call --config '/etc/claude-code/hooks/agent-config/agent-audit.conf'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
