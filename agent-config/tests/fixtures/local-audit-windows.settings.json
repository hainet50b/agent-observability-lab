            "timeout": 10,
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "C:\\Users\\user\\proj\\.claude\\hooks\\agent-audit.ps1",
              "-Stream",
              "tool_call",
              "-Config",
              "C:\\Users\\user\\proj\\.claude\\hooks\\agent-audit.conf"
