{"id":"claude-conversations","type":"search","managed":false,"attributes":{"title":"Claude — Conversations","description":"Per-conversation usage rollup (ES|QL).","hits":0,"columns":["first_seen","last_seen","duration_sec","docs","turns","user_prompts","llm_requests","tool_calls","hooks","input_tokens","cache_read_tokens","cache_creation_tokens","output_tokens","cost_usd","conversation_id"],"sort":[],"isTextBasedQuery":true,"kibanaSavedObjectMeta":{"searchSourceJSON":"{\"query\":{\"esql\":\"FROM logs-apm.app.claude_code*\\n| WHERE labels.prompt_id IS NOT NULL\\n| EVAL ts_ms = TO_LONG(@timestamp)\\n| EVAL is_user_prompt = message == \\\"claude_code.user_prompt\\\"\\n| EVAL is_llm_request = message == \\\"claude_code.api_request\\\"\\n| EVAL is_tool_call = message == \\\"claude_code.tool_result\\\"\\n| EVAL is_hook = message == \\\"claude_code.hook_execution_complete\\\"\\n| STATS\\n    first_seen = MIN(@timestamp),\\n    last_seen = MAX(@timestamp),\\n    duration_sec = (MAX(ts_ms) - MIN(ts_ms)) / 1000.0,\\n    docs = COUNT(*),\\n    turns = COUNT_DISTINCT(labels.prompt_id),\\n    user_prompts = COUNT_DISTINCT(CASE(is_user_prompt, labels.prompt_id, null)),\\n    llm_requests = COUNT_DISTINCT(CASE(is_llm_request, labels.request_id, null)),\\n    tool_calls = COUNT_DISTINCT(CASE(is_tool_call, labels.tool_use_id, null)),\\n    hooks = COUNT(CASE(is_hook, 1, null)),\\n    input_tokens = SUM(CASE(is_llm_request, numeric_labels.input_tokens, null)),\\n    cache_read_tokens = SUM(CASE(is_llm_request, numeric_labels.cache_read_tokens, null)),\\n    cache_creation_tokens = SUM(CASE(is_llm_request, numeric_labels.cache_creation_tokens, null)),\\n    output_tokens = SUM(CASE(is_llm_request, numeric_labels.output_tokens, null)),\\n    cost_usd = SUM(CASE(is_llm_request, numeric_labels.cost_usd, null))\\n  BY conversation_id = session.id\\n| SORT last_seen DESC\"},\"filter\":[]}"}},"references":[],"coreMigrationVersion":"9.4.2"}
