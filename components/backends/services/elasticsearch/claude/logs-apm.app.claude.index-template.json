{
  "index_patterns": [
    "logs-apm.app.claude_code-*"
  ],
  "priority": 250,
  "data_stream": {},
  "composed_of": [
    "logs@mappings",
    "apm@mappings",
    "apm@settings",
    "apm-10d@lifecycle",
    "logs-apm@settings",
    "logs-apm.app-fallback@ilm",
    "logs@custom",
    "logs-apm.app@custom",
    "ecs@mappings",
    "telemetry.claude@lifecycle"
  ],
  "ignore_missing_component_templates": [
    "logs@custom",
    "logs-apm.app@custom",
    "logs-apm.app-fallback@ilm"
  ],
  "template": {
    "settings": {
      "index": {
        "default_pipeline": "logs-apm.app@default-pipeline",
        "final_pipeline": "logs-apm@pipeline"
      }
    }
  }
}
