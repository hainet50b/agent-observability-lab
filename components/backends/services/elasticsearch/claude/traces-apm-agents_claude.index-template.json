{
  "index_patterns": [
    "traces-apm-agents_claude_code*"
  ],
  "priority": 250,
  "data_stream": {},
  "composed_of": [
    "traces@mappings",
    "apm@mappings",
    "apm@settings",
    "apm-10d@lifecycle",
    "traces-apm@mappings",
    "traces-apm-fallback@ilm",
    "traces@custom",
    "traces-apm@custom",
    "ecs@mappings",
    "telemetry.claude@lifecycle"
  ],
  "ignore_missing_component_templates": [
    "traces@custom",
    "traces-apm@custom",
    "traces-apm-fallback@ilm"
  ],
  "template": {
    "settings": {
      "index": {
        "default_pipeline": "traces-apm@default-pipeline",
        "final_pipeline": "traces-apm@pipeline"
      }
    }
  }
}
