{
  "description": "Shared Codex app-logs logic: drop streaming-delta events; redact prompt text and tool I/O.",
  "processors": [
    { "drop": { "if": "ctx.labels?.event_kind == 'response.output_text.delta' || ctx.labels?.event_kind == 'response.function_call_arguments.delta' || ctx.labels?.event_kind == 'response.custom_tool_call_input.delta'" } },
    { "set": { "field": "labels.prompt", "value": "[REDACTED]", "override": true, "if": "ctx.labels?.prompt != null" } },
    { "set": { "field": "labels.arguments", "value": "[REDACTED]", "override": true, "if": "ctx.labels?.arguments != null" } },
    { "set": { "field": "labels.output", "value": "[REDACTED]", "override": true, "if": "ctx.labels?.output != null" } }
  ]
}
