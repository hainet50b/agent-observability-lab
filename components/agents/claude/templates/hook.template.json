{
  "_comment": {
    "docs": ["https://code.claude.com/docs/en/hooks"]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@@USER_PROMPT_COMMAND@@",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@@TOOL_CALL_COMMAND@@",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
