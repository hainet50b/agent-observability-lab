<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>lab.agentobservability.callers</groupId>
    <artifactId>spring-boot-caller</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>spring-boot-caller</name>
    <description>Boots Spring, issues a W3C trace id, and launches the claude CLI one-shot with per-app attribution</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <!-- Deliberately just the core starter: this app emits no telemetry of its own
             (the lab observes the AGENT). It only fabricates a trace id and launches claude. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
