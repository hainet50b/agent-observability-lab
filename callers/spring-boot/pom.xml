<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>lab.agentobservability.callers</groupId>
    <artifactId>spring-boot-caller</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>spring-boot-caller</name>
    <description>Boots Spring, reads the active Micrometer trace, and launches an agent CLI one-shot with per-app attribution</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Micrometer Tracing over OpenTelemetry, granular modules only: the Tracer/Propagator this
             app reads to mint the trace id. No OTLP metrics registry or span exporter is pulled, so
             the app exports nothing — the lab observes the agent's telemetry, not this app's. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
