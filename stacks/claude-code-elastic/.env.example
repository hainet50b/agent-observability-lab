# ============================================================================
# claude-code-elastic — Claude Code telemetry configuration
# ============================================================================
#
# These are the OpenTelemetry environment variables that make Claude Code emit
# its telemetry into this stack. They are read by the `claude` process, NOT by
# docker compose — so they belong in the SHELL where you run Claude Code, not
# in the containers. (The stack itself needs no env file; it runs as-is.)
#
# ---------------------------------------------------------------------------
# How to run a Claude Code session that emits into this stack
# ---------------------------------------------------------------------------
#
#   1. Bring the backend up and wait for it to go healthy:
#
#          cd stacks/claude-code-elastic
#          docker compose up -d
#          docker compose ps        # all three services should be "healthy"
#
#      Elasticsearch → http://localhost:9200, Kibana → http://localhost:5601,
#      APM Server OTLP endpoint → http://localhost:8200.
#
#   2. Copy this file and load it into the shell that will run Claude Code:
#
#          cp .env.example .env
#          set -a; . ./.env; set +a    # POSIX sh / bash: export every var
#
#      (fish: `for l in (grep -v '^#' .env | grep .); set -x (string split -m1 = $l); end`)
#
#   3. Run Claude Code from that same shell, anywhere:
#
#          claude
#
#      Drive a short session — send a prompt, let it read a file or run a
#      command. Metrics flush every OTEL_METRIC_EXPORT_INTERVAL ms and events
#      every OTEL_LOGS_EXPORT_INTERVAL ms, so data lands within ~10s. On a
#      clean exit Claude Code force-flushes, so quitting the session also
#      pushes any pending telemetry.
#
#   4. Look at it in Kibana (http://localhost:5601) via Discover, or query
#      Elasticsearch directly. The smoke/verification script (added in a later
#      task) automates the "did telemetry land?" check.
#
# WARNING (see SPEC invariants): the events channel can carry your prompt text
# and tool input/output. Do not run a telemetry-enabled session containing
# secrets or confidential material against this local demo, and never commit a
# real `.env` or captured telemetry into the repo.
# ============================================================================

# Master switch. Without this, none of the OTEL_* vars below have any effect.
CLAUDE_CODE_ENABLE_TELEMETRY=1

# Enable BOTH channels Claude Code exposes:
#   metrics → counters/gauges (sessions, tokens, cost, lines of code, commits/PRs)
#   logs    → structured events (user prompts, tool results, API requests)
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# OTLP transport. APM Server accepts OTLP/HTTP and OTLP/gRPC on the same port
# (8200). We default to http/protobuf: the OTel exporter POSTs metrics to
# <endpoint>/v1/metrics and events to <endpoint>/v1/logs. To use gRPC instead,
# set this to `grpc` (the endpoint below stays the same).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Where to send it: the APM Server OTLP endpoint published on the host. Both
# the metrics and logs pipelines use this single base endpoint. No
# OTEL_EXPORTER_OTLP_HEADERS / auth token is needed because this demo runs the
# stack with security disabled and no APM secret_token configured.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8200

# Export cadence, lowered from the defaults (60000 / 5000 ms) so telemetry
# shows up quickly in the demo. Raise these for a less chatty session.
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_LOGS_EXPORT_INTERVAL=5000
