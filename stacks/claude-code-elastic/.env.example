# claude-code-elastic — Claude Code telemetry env template.
#
# These OTEL_* vars are read by the `claude` process (NOT docker compose), so
# load them into the SHELL that runs Claude Code; the stack itself needs no env.
# The full workflow — copy to .env, load it (bash/zsh or fish), run a session,
# view in Kibana — is in ./README.md (Quick Tour).
#
# Safety: the events channel can carry prompt text and tool I/O. Never run a
# telemetry-enabled session containing secrets against this local demo, and
# never commit a real .env or captured telemetry into the repo.

# Master switch — without this the OTEL_* vars below have no effect.
CLAUDE_CODE_ENABLE_TELEMETRY=1

# Enable both channels: metrics (sessions, tokens, cost, …) and logs/events
# (prompts, tool results, API requests).
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# OTLP transport (set to `grpc` for OTLP/gRPC; the endpoint below is unchanged).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# APM Server OTLP endpoint published on the host (no auth: demo runs security off).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8200

# Export cadence, lowered from defaults (60000 / 5000) so data shows up fast.
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_LOGS_EXPORT_INTERVAL=5000
