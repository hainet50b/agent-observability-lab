# Local secrets overlay (gitignored). Copy to setup.local.conf and fill in.
# Read by scripts/setup-config.{sh,ps1} in addition to setup.conf; absent or
# empty → the audit hook ships with no API key (fine for the local demo backend,
# whose security is disabled).
#
# agent_audit.elasticsearch.api_key: a base64 "id:api_key" credential scoped to
# create_doc on the audit data streams (see SPEC/agent-audit.md).
agent_audit.elasticsearch.api_key=
