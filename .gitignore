# Local editor / OS noise
.DS_Store
*.swp
*.swo
.idea/

# Per-machine Claude Code settings generated by scripts/setup.* (any depth).
.claude/

# Per-machine Claude Code project MCP config generated by render-mcp.* — scoped to the
# Claude stacks (a bare `.mcp.json` would over-broadly ignore project MCP configs that
# are normally meant to be committed/shared via version control).
/stacks/claude-code-*/.mcp.json

# Per-machine Codex CLI session config generated by scripts/setup.* (any depth).
.codex/

# Captured telemetry must never be committed (events can contain prompt/tool content).
*.ndjson.local

# Runtime artifacts — agent-written capture output (e.g. OTEL_LOG_RAW_API_BODIES=file:).
# Raw API bodies contain prompts, tool results, file contents: never committed.
/var/

# Note: reports/ is intentionally NOT ignored. Ralph's HTML reports
# (including rotated archives) are kept as Git history.
